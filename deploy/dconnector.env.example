# Variables de dconnector-server (docs/14-API-SERVIDOR.md). Copie a /etc/dconnector/dconnector.env
# (permisos 0600, dueño root: systemd lo lee como root). Un indicador de la línea de comandos gana a la variable.

# Dirección y puerto de escucha. Fuera de loopback exige TLS (o DCONNECTOR_INSECURE=true).
DCONNECTOR_LISTEN=0.0.0.0:8443

# Carpeta de datos (con systemd la fija la unidad: /var/lib/dconnector).
#DCONNECTOR_DATA=/var/lib/dconnector

# Certificado TLS externo (PEM). Si no se indica, se genera uno propio en <datos>/tls y se imprime su huella.
# Se recarga con SIGHUP (systemctl reload dconnector).
#DCONNECTOR_TLS_CERT=/etc/dconnector/tls/fullchain.pem
#DCONNECTOR_TLS_KEY=/etc/dconnector/tls/privkey.pem

# Sin TLS: solo en loopback, o detrás de un proxy inverso con DCONNECTOR_INSECURE=true.
#DCONNECTOR_NO_TLS=false
# Permite escuchar fuera de loopback sin TLS (NO recomendado; aviso ruidoso cada minuto en el registro).
#DCONNECTOR_INSECURE=false

# Administrador del primer arranque (usuario y, opcionalmente, clave de 12 caracteres o más).
# Sin clave se genera una y se imprime UNA vez en la salida estándar (journalctl -u dconnector).
DCONNECTOR_ADMIN_USER=admin
#DCONNECTOR_ADMIN_PASSWORD=   (bórrela de este archivo tras el primer arranque: ya no hace falta y es una clave en claro)

# Orígenes extra permitidos para el WebSocket y CORS, separados por comas.
#DCONNECTOR_ALLOW_ORIGIN=https://panel.ejemplo.com

# Registro detallado.
#DCONNECTOR_VERBOSE=false

# Modo local (lo usa la app de escritorio por entorno; en un servidor NO se define).
#DCONNECTOR_LOCAL_TOKEN=

# Zona horaria del servidor.
TZ=America/Guayaquil
